# Production build → connect the frontend to the deployed Laravel backend.
# The Laravel API routes live under /api on this host (e.g. https://api.pakkapatriot.com/api/blogs).
# Note: the base must end in /api — the frontend appends /blogs, /data, /shop/products, /orders.
VITE_LARAVEL_API_URL=https://api.pakkapatriot.com/api
